{
  "name": "loan-application",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn db:up && yarn workspaces foreach --all --exclude loan-application --parallel --interlaced --verbose run dev",
    "api": "yarn workspace api",
    "web": "yarn workspace web",
    "db:up": "docker compose -f apps/api/compose.yml up -d",
    "db:down": "docker compose -f apps/api/compose.yml stop"
  },
  "packageManager": "yarn@4.18.0"
}
